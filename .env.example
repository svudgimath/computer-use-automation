# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# Required for the discovery agent (LLM-driven run). Not needed for replay.
ANTHROPIC_API_KEY=

# Model used for the observe -> decide -> act loop. claude-sonnet-5 is the
# default: cheap/fast enough for a multi-step tool-calling loop with image
# input on every turn. Bump to claude-opus-5 for harder pages.
AGENT_MODEL=claude-sonnet-5

# Target app the agent/replay drive. Defaults to the local mock legacy banking app.
TARGET_BASE_URL=http://localhost:4000

# Port the mock target app listens on.
TARGET_APP_PORT=4000

# Set to 1 to run the browser headed (visible) instead of headless.
# Headed is required for the human-escalation demo, since a human needs to see the window.
HEADED=0
